# Outreach Configuration
# Copy this file to config.py and fill in your values

# SMTP Server Settings
SMTP_HOST = "smtp.gmail.com"     
SMTP_PORT = 465                      # 465 for SSL, 587 for STARTTLS
SMTP_USER = "hello@yourdomain.com"
SMTP_PASSWORD = "YOUR_SMTP_PASSWORD"

# Sender Details
FROM_EMAIL = "hello@yourdomain.com"
FROM_NAME = "Your Name"

# BCC: Track all sent emails by CC'ing yourself
BCC = "hello@yourdomain.com"

# Rate limiting (randomized human-like seconds between sends for Primary Inbox safety)
SEND_DELAY = 30
MIN_SEND_DELAY = 60
MAX_SEND_DELAY = 150

# Gmail Primary Inbox Safety Cap (30/day safe on healthy aged Gmail with 60-150s delays)
DAILY_SEND_LIMIT = 30

# Minimum ready-to-send Tier-1 leads before daily autopilot auto-scrapes fresh pairs
MIN_READY_POOL = 35

# Instant Hot-Reply Alert Destination (receives prospect reply + AI-drafted closing response)
ALERT_EMAIL = "your_personal_inbox@gmail.com"

# Optional run cap (uncomment to limit emails per run)
# MAX_EMAILS_PER_RUN = 30

# Automated Follow-Up Schedule (days after previous email in same thread)
FOLLOWUP_1_DAYS = 3
FOLLOWUP_2_DAYS = 7

# Gemini AI Configuration (get key from https://aistudio.google.com/apikey)
# Paste your key here OR set GEMINI_API_KEY as an environment variable
GEMINI_API_KEY = "YOUR_GEMINI_API_KEY"
GEMINI_MODEL = "gemini-3.5-flash-lite"   # Ultra-low-cost & fast for bulk lead scoring + 50-word emails
DEMO_MODEL = "gemini-4-hydrogen"         # Used ONLY when a client actually replies (near-$0 cost!)

# Lead Qualification Thresholds (1-10 scale)
MIN_LEAD_SCORE = 7           # Leads below 7 are auto-rejected
WHALE_SCORE_THRESHOLD = 9    # 9-10/10 Whale leads get an auto-generated custom HTML demo

# Reply Checker Settings (IMAP)
IMAP_HOST = "imap.gmail.com"
IMAP_USER = SMTP_USER
IMAP_PASSWORD = SMTP_PASSWORD
CHECK_DAYS = 14

